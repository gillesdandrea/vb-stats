{
  "env": {
    "ENABLE_LSP_TOOLS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_context",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_status",
      "mcp__codewiki__ask_about_repository",
      "mcp__codewiki__get_repository_docs",
      "mcp__codewiki__search_repository",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.npmjs.org)"
    ],
    "deny": ["Read(.codex/**)", "Read(.history/**)", "Read(node_modules/**)", "Read(AGENTS.md)"],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["codewiki", "codegraph"],
  "disabledMcpjsonServers": ["shadcn", "ai-elements"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bunx prettier --write \"$CLAUDE_FILE_PATHS\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun codegraph sync --quiet 2>/dev/null &"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Frog.aiff"
          }
        ]
      }
    ]
  }
}
