{
  "name": "vb-stats",
  "private": true,
  "version": "0.13.2",
  "homepage": "https://gillesdandrea.github.io/vb-stats",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "run-p lint:prettier lint:es lint:style",
    "lint:fix": "run-s lint:prettier:fix lint:es:fix lint:style:fix",
    "lint:es": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:es:fix": "eslint . --fix",
    "lint:es:config": "eslint . --inspect-config",
    "lint:prettier": "prettier . --check",
    "lint:prettier:fix": "prettier . --write",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "pnpm lint:style --fix",
    "preview": "vite preview",
    "NOpredeploy": "pnpm run build",
    "deploy": "gh-pages -d dist",
    "generate-pwa-assets": "pwa-assets-generator",
    "cdf-scrap": "tsx src/scripts/cdf-scrap.ts",
    "vb-scrap": "tsx src/scripts/vb-scrap.ts",
    "pdf-parse": "tsx src/scripts/pdf-parse.ts",
    "cdf-update": "run-s cdf-scrap build deploy deploy"
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.0",
    "@ant-design/icons": "^6.0.0",
    "@tanstack/react-query": "^5.75.0",
    "antd": "^5.24.9",
    "axios": "^1.9.0",
    "classnames": "^2.5.1",
    "d3-graphviz": "^5.6.0",
    "d3-selection": "^3.0.0",
    "lodash": "^4.17.21",
    "papaparse": "^5.5.2",
    "query-string": "^9.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-use": "^17.6.0",
    "recharts": "^2.15.3",
    "ts-trueskill": "^5.1.0"
  },
  "devDependencies": {
    "@nabla/vite-plugin-eslint": "^2.0.5",
    "@supercharge/promise-pool": "^3.2.0",
    "@tanstack/eslint-plugin-query": "^5.74.7",
    "@types/d3-graphviz": "^2.6.10",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "gh-pages": "^6.3.0",
    "globals": "^16.0.0",
    "npm-run-all2": "^7.0.2",
    "pdf2json": "^3.1.5",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.4.1",
    "sass": "^1.87.0",
    "stylelint": "^16.19.1",
    "stylelint-config-clean-order": "^7.0.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-prettier": "^5.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.3.4",
    "vite-plugin-pwa": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "packageManager": "pnpm@9.15.0"
}
