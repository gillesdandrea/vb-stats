{
  "name": "vb-stats",
  "private": true,
  "version": "0.15.0",
  "homepage": "https://gillesdandrea.github.io/vb-stats",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "run-p lint:prettier lint:es lint:style",
    "lint:fix": "run-s lint:prettier:fix lint:es:fix lint:style:fix",
    "lint:es": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:es:fix": "eslint . --fix",
    "lint:es:config": "eslint . --inspect-config",
    "lint:prettier": "prettier . --check",
    "lint:prettier:fix": "prettier . --write",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "lint:style:fix": "pnpm lint:style --fix",
    "preview": "vite preview",
    "NOpredeploy": "pnpm run build",
    "deploy": "gh-pages -d dist",
    "generate-pwa-assets": "pwa-assets-generator",
    "cdf-scrap": "tsx src/scripts/cdf-scrap.ts",
    "vb-scrap": "tsx src/scripts/vb-scrap.ts",
    "pdf-parse": "tsx src/scripts/pdf-parse.ts",
    "cdf-analysis": "tsx src/scripts/cdf-pool-analysis.ts",
    "cdf-comparison": "tsx src/scripts/cdf-pool-comparison.ts",
    "cdf-validation": "tsx src/scripts/cdf-rule-validation.ts",
    "cdf-geocode": "tsx src/scripts/cdf-geocode.ts",
    "cdf-update": "run-s cdf-scrap build deploy deploy"
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.1",
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.103.1",
    "antd": "^6.6.4",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "d3-graphviz": "^5.6.0",
    "d3-selection": "^3.0.0",
    "lodash": "^4.18.1",
    "papaparse": "^5.7.0",
    "query-string": "^9.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-use": "^17.6.1",
    "recharts": "^3.10.1",
    "ts-trueskill": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@supercharge/promise-pool": "^3.3.0",
    "@tanstack/eslint-plugin-query": "^5.103.1",
    "@types/d3-graphviz": "^3.1.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^9.0.3",
    "pdf2json": "^4.1.0",
    "prettier": "^3.9.8",
    "prettier-eslint": "^17.1.2",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8",
    "stylelint-prettier": "^5.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.5.1"
}
